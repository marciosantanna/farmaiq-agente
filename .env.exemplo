# =====================================================
# CONFIGURACAO DO AGENT - copie este arquivo para .env
# e preencha com os valores reais
# =====================================================

# URL da API na nuvem (Render)
CLOUD_API_URL=https://gerencial-api-3rsq.onrender.com

# Chave secreta compartilhada com a API
AGENT_API_KEY=sua_chave_aqui

# ID da filial
FILIAL_ID=1

# Intervalo entre sincronizacoes em minutos (padrao: 15)
AGENT_INTERVALO_MIN=15

# --- FARMASOFT (Firebird) ---
FARMASOFT_HOST=localhost
FARMASOFT_PORT=3050
FARMASOFT_DATABASE=C:/FarmasoftData/FARMASOFT.FDB
FARMASOFT_USER=SYSDBA
FARMASOFT_PASSWORD=masterkey
